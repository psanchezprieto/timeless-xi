# ─── Frontend (Vite) ────────────────────────────────────────────────────────
# These are baked into the JS bundle at build time by Vite.
# VITE_* vars are SAFE to expose in the browser — they are write-only tokens.

# PostHog project write key (get from PostHog → Project Settings → Project API key)
VITE_POSTHOG_KEY=phc_REPLACE_WITH_YOUR_KEY

# PostHog data region. Use https://eu.posthog.com if your project is in the EU region.
VITE_POSTHOG_HOST=https://eu.posthog.com

# Set to 'false' to disable all analytics locally (useful during dev)
VITE_POSTHOG_ENABLED=true

# ─── Server-side scripts only (GitHub Actions / local enrichment) ────────────
# These NEVER go in the frontend. Add them as GitHub Secrets for CI.

# Anthropic API key — used by scripts/enrich-ratings.mjs
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY

# Zafronix API key — used by scripts/fetch-squads.mjs
ZAFRONIX_API_KEY=REPLACE_IF_NEEDED

# PostHog personal API key — used by the stats page GitHub Action / local script
# (get from PostHog → User icon → Personal API keys → Create)
POSTHOG_PERSONAL_KEY=phx_REPLACE_WITH_YOUR_KEY

# PostHog project ID — used by scripts/update-community-stats.mjs
# (get from PostHog → Project Settings → Project ID)
POSTHOG_PROJECT_ID=REPLACE_WITH_YOUR_PROJECT_ID

# PostHog query base URL for server-side querying
# Use https://eu.i.posthog.com for EU projects, or https://us.i.posthog.com for US projects.
POSTHOG_API_HOST=https://eu.i.posthog.com

# Optional override for the start of the stats window.
# If omitted, the script uses the first git commit date so the stats cover the project from the start.
POSTHOG_START_DATE=2026-06-07T16:17:16Z

# Optional override for a rolling window in days.
# If unset, the script defaults to "since project start" instead of the previous 90-day view.
POSTHOG_LOOKBACK_DAYS=

# Keep shell-style assignments without spaces around '=' to avoid issues when sourcing .env in bash.
# Example:
#   set -a && . ./.env && set +a
#   npm run stats:update
